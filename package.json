{
  "name": "framelab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive, verified 2D structural behaviour explorer by Lokesh Kumar.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:offline": "npm run build && node scripts/package-offline.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
